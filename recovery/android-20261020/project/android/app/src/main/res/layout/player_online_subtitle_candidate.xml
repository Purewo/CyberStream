<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:background="@drawable/player_panel_item_background"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="118dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/online_subtitle_candidate_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="#F2FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/online_subtitle_candidate_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#8FFFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/online_subtitle_candidate_preview"
            android:layout_width="92dp"
            android:layout_height="48dp"
            android:background="@drawable/player_cellular_warning_once"
            android:fontFamily="sans-serif-medium"
            android:text="预览"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/online_subtitle_candidate_bind"
            android:layout_width="92dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/player_cellular_warning_always"
            android:fontFamily="sans-serif-medium"
            android:text="绑定"
            android:textAllCaps="false"
            android:textColor="#FF111318"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
