<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cellular_warning_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF080808"
    android:clickable="true"
    android:focusable="true"
    android:keepScreenOn="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="@dimen/cellular_warning_content_vertical_padding"
            android:paddingEnd="24dp"
            android:paddingBottom="@dimen/cellular_warning_content_vertical_padding">

            <ImageView
                android:id="@+id/cellular_warning_poster"
                android:layout_width="@dimen/cellular_warning_art_width"
                android:layout_height="@dimen/cellular_warning_art_height"
                android:background="@drawable/player_cellular_poster_placeholder"
                android:clipToOutline="true"
                android:contentDescription="影片主海报"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/cellular_warning_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#B8FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/cellular_warning_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="@dimen/cellular_warning_actions_width"
                android:layout_height="@dimen/cellular_warning_button_height"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/cellular_warning_allow_once"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/player_cellular_warning_once"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="本次允许"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/cellular_warning_allow_always"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/player_cellular_warning_always"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="始终允许"
                    android:textAllCaps="false"
                    android:textColor="#FF090909"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/cellular_warning_exit"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/cellular_warning_exit_height"
        android:layout_gravity="top|end"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="26dp"
        android:background="@drawable/player_cellular_warning_exit"
        android:drawableStart="@drawable/ic_player_close"
        android:drawablePadding="8dp"
        android:fontFamily="sans-serif-medium"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="20dp"
        android:stateListAnimator="@null"
        android:text="退出播放"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp" />
</FrameLayout>
