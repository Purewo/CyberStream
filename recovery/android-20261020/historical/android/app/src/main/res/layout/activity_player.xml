<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/media_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true"
        app:controller_layout_id="@layout/cyber_player_controls"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:show_timeout="3000" />

    <!-- Kept outside PlayerView so ZOOM can crop video without cropping text. -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/external_subtitle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:paddingStart="32dp"
        android:paddingEnd="32dp" />

    <View
        android:id="@+id/player_gesture_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="122dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/seek_gesture_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_seek_gesture_background"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minWidth="148dp"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/adjustment_gesture_overlay"
        android:layout_width="164dp"
        android:layout_height="72dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="28dp"
        android:background="@drawable/player_seek_gesture_background"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/adjustment_gesture_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="亮度"
                android:src="@drawable/ic_player_brightness"
                android:tint="#FF5BE7FF" />

            <TextView
                android:id="@+id/adjustment_gesture_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/adjustment_gesture_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progressBackgroundTint="#35FFFFFF"
            android:progressTint="#FF5BE7FF" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/player_error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="@dimen/player_error_card_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/player_side_panel_background"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/player_error_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="无法播放此文件"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/player_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#BFFFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/player_error_retry"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/player_cellular_warning_once"
                    android:fontFamily="sans-serif-medium"
                    android:text="重试"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/player_error_exit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/player_cellular_warning_always"
                    android:fontFamily="sans-serif-medium"
                    android:text="退出播放"
                    android:textAllCaps="false"
                    android:textColor="#FF111318"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/side_panel_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/side_panel"
        android:layout_width="@dimen/player_side_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/player_side_panel_background"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/side_panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />

            <ImageButton
                android:id="@+id/side_panel_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭面板"
                android:padding="11dp"
                android:src="@drawable/ic_player_close"
                android:tint="#D9FFFFFF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:background="#1FFFFFFF" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/side_panel_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
