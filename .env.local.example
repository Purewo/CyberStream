# Local runtime overrides for CyberStream backend.
# Copy to .env.local and fill secrets. .env.local is intentionally ignored.

# Minimal private deployment guard. When set, management APIs require:
# Authorization: Bearer <token> or X-Cyber-API-Token: <token>.
# Health checks and public media/image streaming GETs remain accessible.
CYBER_API_TOKEN=
CYBER_AUTH_ENABLED=true

# Optional multi-user mode. Default is off so existing deployments keep working.
# When enabled, browser clients authenticate with an HttpOnly cookie session.
# CYBER_API_TOKEN remains a break-glass admin token.
CYBER_USER_MANAGEMENT_ENABLED=false
CYBER_SESSION_SECRET=
CYBER_SESSION_COOKIE_SECURE=false
CYBER_SESSION_DAYS=30
CYBER_LOGIN_RATE_LIMIT_ENABLED=true
CYBER_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
CYBER_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
CYBER_LOGIN_RATE_LIMIT_LOCK_SECONDS=900
CYBER_BOOTSTRAP_ADMIN_USERNAME=
CYBER_BOOTSTRAP_ADMIN_PASSWORD=
CYBER_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# Metadata provider secrets. Keep real values only in .env.local.
TMDB_TOKEN=

# Keep backend workers at 1 until scan status and scan locks are moved out of
# process memory. Multiple gunicorn workers can show inconsistent /scan state.
CYBER_GUNICORN_WORKERS=1

# Super CDN poster layer. Keep video streaming on the normal storage provider.
CYBER_CDN_PROVIDER=supercdn
CYBER_SUPERCDN_ENABLED=true
CYBER_SUPERCDN_URL=https://qwk.ccwu.cc
CYBER_SUPERCDN_TOKEN=
CYBER_SUPERCDN_BUCKET=hd-wallpapers
CYBER_SUPERCDN_BUCKET_NAME='高清壁纸桶'
CYBER_SUPERCDN_BUCKET_DESCRIPTION='CyberStream poster images'
CYBER_SUPERCDN_BUCKET_ALLOWED_TYPES=image
CYBER_SUPERCDN_ROUTE_PROFILE=china_all
CYBER_SUPERCDN_AUTO_UPLOAD_IMAGES=true
CYBER_SUPERCDN_AUTO_UPLOAD_SUBTITLES=false
CYBER_SUPERCDN_SERVE_ASSET_URLS=true
CYBER_SUPERCDN_TIMEOUT_SECONDS=120

# Official PC update-check API. The manifest is maintained by backend release
# operations and contains public CDN download URLs only; clients do not call
# the CDN control plane.
CYBER_UPDATE_DEFAULT_CHANNEL=stable
CYBER_UPDATE_MANIFEST_PATH=update-manifest.json
CYBER_UPDATE_CDN_URL_PREFIXES=https://qwk.ccwu.cc

# Managed localhost AList for simplified cloud-disk mounting. AList should not
# be exposed publicly; CyberStream calls it locally and returns only its final
# cloud 302 URL to clients.
CYBER_MANAGED_ALIST_ENABLED=false
CYBER_MANAGED_ALIST_BASE_URL=http://127.0.0.1:5244
CYBER_MANAGED_ALIST_USERNAME=admin
CYBER_MANAGED_ALIST_PASSWORD=
CYBER_MANAGED_ALIST_TOKEN=
CYBER_MANAGED_ALIST_MOUNT_PREFIX=/cyberstream
CYBER_MANAGED_ALIST_TIMEOUT_SECONDS=30
CYBER_MANAGED_ALIST_VERIFY_SSL=false

# 本机 OpenList 托管天翼云盘 189CloudTV、115、阿里云盘、QuarkTV、UCTV 扫码登录（不要暴露到公网）
CYBER_MANAGED_OPENLIST_ENABLED=false
CYBER_MANAGED_OPENLIST_BASE_URL=http://127.0.0.1:5245
CYBER_MANAGED_OPENLIST_USERNAME=admin
CYBER_MANAGED_OPENLIST_PASSWORD=
CYBER_MANAGED_OPENLIST_TOKEN=
CYBER_MANAGED_OPENLIST_MOUNT_PREFIX=/cyberstream
CYBER_MANAGED_OPENLIST_TIMEOUT_SECONDS=30
CYBER_MANAGED_OPENLIST_VERIFY_SSL=false
CYBER_MANAGED_OPENLIST_ALIYUNDRIVE_AUTH_MODE=auto
CYBER_MANAGED_OPENLIST_ALIYUNDRIVE_CLIENT_ID=
CYBER_MANAGED_OPENLIST_ALIYUNDRIVE_CLIENT_SECRET=
CYBER_MANAGED_OPENLIST_ALIYUNDRIVE_PUBLIC_API_BASE_URL=https://api.oplist.org/alicloud
CYBER_MANAGED_OPENLIST_ALIYUNDRIVE_RENEW_API_URL=https://api.oplist.org/alicloud/renewapi
# 留空时使用 AList 公开默认百度 OAuth 应用；需要自有应用时再覆盖。
CYBER_MANAGED_OPENLIST_BAIDUNETDISK_CLIENT_ID=
CYBER_MANAGED_OPENLIST_BAIDUNETDISK_CLIENT_SECRET=
CYBER_MANAGED_OPENLIST_BAIDUNETDISK_RENEW_API_URL=https://api.oplist.org/baiduyun/renewapi
